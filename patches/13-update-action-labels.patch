+	private maybeShowUpdateNotification(state: UpdateState): void {
+		switch (state.type) {
+			case StateType.AvailableForDownload:
+				this.showUpdateNotification(
+					state.type,
+					state.update,
+					nls.localize('thereIsUpdateAvailable', "There is a new {0} update available.", this.productService.nameLong),
+					nls.localize('download update', "Download Now"),
+					() => this.updateService.downloadUpdate(true)
+				);
+				break;
+
+			case StateType.Ready:
+				this.showUpdateNotification(
+					state.type,
+					state.update,
+					nls.localize('updateAvailableAfterRestart', "Restart {0} to apply the latest update.", this.productService.nameLong),
+					nls.localize('restartNow', "Restart Now"),
+					() => this.updateService.quitAndInstall()
+				);
+				break;
+		}
+	}
+
+	private showUpdateNotification(stateType: StateType, update: IUpdate, message: string, primaryLabel: string, primaryAction: () => void): void {
+		const version = update.productVersion ?? update.version;
+		const notificationKey = `${stateType}:${version}`;
+
+		if (this.lastUpdateNotificationKey === notificationKey) {
+			return;
+		}
+
+		this.lastUpdateNotificationKey = notificationKey;
+
+		const actions = [{
+			label: primaryLabel,
+			run: primaryAction
+		}];
+
+		if (update.productVersion) {
+			actions.push({
+				label: nls.localize('releaseNotes', "Release Notes"),
+				run: () => {
+					this.instantiationService.invokeFunction(accessor => showReleaseNotes(accessor, update.productVersion!));
+				}
+			});
+		}
+
+		this.notificationService.prompt(
+			severity.Info,
+			message,
+			actions,
+			{ sticky: true, priority: NotificationPriority.DEFAULT }
+		);
+	}
+
 	private registerGlobalActivityActions(): void {
 		CommandsRegistry.registerCommand('update.check', () => this.updateService.checkForUpdates(true));
 		CommandsRegistry.registerCommand('update.checking', () => { });
