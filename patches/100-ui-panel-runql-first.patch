+	private getEffectiveOrder(id: string, fallback: number | undefined): number | undefined {
+		if (this.location === ViewContainerLocation.Panel) {
+			const order = RUNQL_PANEL_ORDER.get(id);
+			if (order !== undefined) {
+				return order;
+			}
+		}
+		return fallback;
+	}
+
+	private migrateRunQLPanelOrderOnce<T extends { id: string; order?: number }>(items: readonly T[]): T[] {
+		const withEffectiveOrder = items.map(item => ({
+			...item,
+			order: this.getEffectiveOrder(item.id, item.order),
+		} as T));
+
+		if (this.location !== ViewContainerLocation.Panel || this.storageService.getBoolean(RUNQL_PANEL_ORDER_MIGRATION_STORAGE_KEY, StorageScope.PROFILE, false)) {
+			return withEffectiveOrder;
+		}
+
+		this.storageService.store(RUNQL_PANEL_ORDER_MIGRATION_STORAGE_KEY, true, StorageScope.PROFILE, StorageTarget.USER);
+
+		const runqlItems = Array.from(RUNQL_PANEL_ORDER.keys())
+			.map(id => withEffectiveOrder.find(item => item.id === id))
+			.filter((item): item is T => !!item);
+
+		const otherItems = withEffectiveOrder.filter(item => !RUNQL_PANEL_ORDER.has(item.id));
+		return [...runqlItems, ...otherItems];
+	}
