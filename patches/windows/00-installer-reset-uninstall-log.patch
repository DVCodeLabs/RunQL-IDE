+    RecoverUninstallLogBackupIfStale();
+    BackupUninstallLogIfTooLarge();
+  end;
+  if CurStep = ssDone then begin
+    DiscardUninstallLogBackupOnSuccess();
+  end;
+
   if CurStep = ssPostInstall then
   begin
     LogContextMenuInstallState();
